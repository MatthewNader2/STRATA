      "outputs": {
        "drift_nm": {
          "type_name": "float",
          "state": "drift_readout",
          "abstract_type": "scalar",
          "port_role": "metric_output",
          "description": "Thermal drift in nanometers.",
          "structure_kind": "scalar",
          "semantics": "aetheris.drift_readout",
          "typestate": "aetheris::drift_readout"
        }
