      "dependencies": ["import aetheris"],
      "primary_in": "bench",
      "primary_out": "drift_nm",
      "effects": ["sensor_read"],
      "mutation_type": "pure"
    },
    {
      "cell_id": "AETHERIS_AUDIT_FRINGE_CONTRAST",
      "stage": 2,
      "domain_name": "aetheris",
      "node_type": "function",
      "node_role": "evaluator",
      "topology_type": "sequential",
