      "stage": 3,
      "domain_name": "aetheris",
      "node_type": "function",
      "node_role": "sink",
      "topology_type": "terminal",
      "docstring": "Safely parks pneumatic isolators and shuts down a mounted OpticalBench.",
      "semantic_tags": ["park_optical_table", "park_bench", "shutdown_table"],
      "inputs": {
        "bench": {
          "type_name": "OpticalBench",
          "state": "bench_mounted",
          "abstract_type": "handle",
          "required": true,
          "port_role": "data_input",
          "description": "Mounted OpticalBench handle.",
          "structure_kind": "handle",
          "semantics": "aetheris.bench_mounted",
          "typestate": "aetheris::bench_mounted"
        }
      },
      "outputs": {},
      "code_template": "aetheris.park_optical_table({bench})",
      "dependencies": ["import aetheris"],
      "primary_in": "bench",
