# --- Build Artifacts & Packaging ---
build/
dist/
*.spec
*.egg-info/
packaging/
android_app/
frontend/
frontend_dist/

# --- AI Models (Large binary weights - downloaded via scripts/download_model.py) ---
models/
model_cache/
model_3/
.rag_cache/

# --- Compiled Databases & Caches (generated at runtime) ---
trees/*.db
trees/*.backup
trees/*.bak
harvests/
backup/

