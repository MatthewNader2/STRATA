*.py[cod]
*$py.class
*.so
*.so.*
*.dylib
*.dll
.pytest_cache/
.tmp_venv/
venv/
.venv/
env/
.env

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*~
.~lock.*
