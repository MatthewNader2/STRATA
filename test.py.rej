 def print_overnight_master_summary(
     prompt_summaries: List[Dict[str, Any]],
     total_suite_duration: float,
-    cache_savings_sec: float = 0.0,
+    cold_route: bool = True,
     use_rich: bool = True,
 ) -> None:
-    """Prints the comprehensive multi-prompt synthesis summary across overnight runs."""
-    total_runs = sum(s.get("total_runs", 0) for s in prompt_summaries)
