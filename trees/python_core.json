      },
      "outputs": {
        "output_var": {
          "type_name": "list",
          "state": "sorted_list",
          "required": true,
          "structure_kind": "collection",
          "rank": 1,
          "element_type": "composite_record",
          "supported_formats": [],
          "abstract_type": "collection",
          "shape_contract": {
            "ndim": 1,
            "shape": [
              "N"
            ],
            "rank_polymorphic": false,
            "channel_count": null,
            "channel_axis": null,
            "len": null
          }
        }
      },
      "code_template": "def merge_sort(arr):\n    if len(arr) <= 1:\n        return arr\n    mid = len(arr) // 2\n    left = merge_sort(arr[:mid])\n    right = merge_sort(arr[mid:])\n    res = []\n    i = j = 0\n    while i < len(left) and j < len(right):\n        if left[i] <= right[j]:\n            res.append(left[i])\n            i += 1\n        else:\n            res.append(right[j])\n            j += 1\n    res.extend(left[i:])\n    res.extend(right[j:])\n    return res\n\n{output_var} = merge_sort({data})",
      "primary_in": "data",
      "primary_out": "output_var",
      "dependencies": [],
      "verified": 1,
      "source_priority": 100,
      "slots": [
        "data",
        "output_var"
      ],
      "endable": true
    },
