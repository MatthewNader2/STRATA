      "cell_id": "PYTHON_DIJKSTRA_ALGORITHM",
      "stage": 2,
      "domain_name": "python_core",
      "node_type": "function",
      "node_role": "transformation",
      "docstring": "Dijkstra shortest path algorithm on graph adjacency dictionary.",
      "keywords": [
        "algorithm",
        "dijkstra",
        "shortest_path",
        "shortest",
        "path",
        "graph",
        "distances",
        "heapq",
        "bfs",
        "dfs",
        "traversal",
        "search"
      ],
      "inputs": {
        "graph": {
          "type_name": "dict",
          "state": "adjacency_dict",
          "required": false,
          "default_value": "{}",
          "port_role": "data_input",
          "structure_kind": "composite",
          "rank": 0,
          "element_type": "composite_record",
          "supported_formats": [],
          "carrier": "dict",
          "layout": {
            "rank": 0,
            "shape": null,
            "dtype": "composite_record",
            "memory_order": "any",
            "rank_polymorphic": false,
            "channel_count": null,
            "channel_axis": null,
            "length": null
          },
          "semantics": "python_core.adjacency_dict",
          "typestate": "python_core::adjacency_dict",
          "invariants": []
        },
        "start": {
          "type_name": "str",
          "state": "source_node",
          "required": false,
          "default_value": "''",
          "port_role": "literal_parameter",
          "structure_kind": "scalar",
          "rank": 0,
          "element_type": "string",
          "supported_formats": [],
          "carrier": "str",
          "layout": {
            "rank": 0,
            "shape": null,
            "dtype": "string",
            "memory_order": "any",
            "rank_polymorphic": false,
            "channel_count": null,
            "channel_axis": null,
            "length": null
          },
          "semantics": "python_core.source_node",
          "typestate": "python_core::source_node",
          "invariants": []
        }
      },
      "outputs": {
        "output_var": {
          "type_name": "dict",
          "state": "distances",
          "required": true,
          "structure_kind": "composite",
          "rank": 0,
          "element_type": "composite_record",
          "supported_formats": [],
          "carrier": "dict",
          "layout": {
            "rank": 0,
            "shape": null,
            "dtype": "composite_record",
            "memory_order": "any",
            "rank_polymorphic": false,
            "channel_count": null,
            "channel_axis": null,
            "length": null
          },
          "semantics": "python_core.distances",
          "typestate": "python_core::distances",
          "invariants": []
        }
      },
      "code_template": "import heapq\n\ndef dijkstra(graph, start):\n    distances = dict.fromkeys(graph, float('inf'))\n    if start in distances:\n        distances[start] = 0\n    pq = [(0, start)] if start in distances else []\n    while pq:\n        curr_dist, curr_node = heapq.heappop(pq)\n        if curr_dist > distances.get(curr_node, float('inf')):\n            continue\n        for neighbor, weight in graph.get(curr_node, {}).items():\n            dist = curr_dist + weight\n            if dist < distances.get(neighbor, float('inf')):\n                distances[neighbor] = dist\n                heapq.heappush(pq, (dist, neighbor))\n    return distances\n\n{output_var} = dijkstra({graph}, {start})",
      "primary_in": "graph",
      "primary_out": "output_var",
      "dependencies": [
        "import heapq"
      ],
      "verified": 1,
      "slots": [
        "graph",
        "start",
        "output_var"
      ],
      "endable": true,
      "effects": [],
      "mutation_type": "pure"
    },
