      "cell_id": "PYTHON_DIJKSTRA_ALGORITHM",
      "stage": 2,
      "domain_name": "python_core",
      "node_type": "function",
      "node_role": "transformation",
      "docstring": "Dijkstra shortest path algorithm on graph adjacency dictionary.",
      "keywords": [
        "algorithm",
        "dijkstra",
