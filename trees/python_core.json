        "divide_and_conquer"
      ],
      "inputs": {
        "data": {
          "type_name": "list",
          "state": "raw_list",
          "required": false,
          "default_value": "[]",
          "port_role": "data_input",
          "structure_kind": "collection",
          "rank": 1,
          "element_type": "composite_record",
          "supported_formats": [],
          "abstract_type": "collection",
          "shape_contract": {
            "ndim": 1,
            "shape": [
              "N"
            ],
            "rank_polymorphic": false,
            "channel_count": null,
            "channel_axis": null,
            "len": null
