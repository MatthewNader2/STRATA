# STRATA v2 Configuration (pydantic-settings env_prefix = "NSTL_")
# Copy to .env to override defaults in src/config.py (NSTLSettings).

# --- Directory Overrides (defaults resolve relative to PROJECT_ROOT) ---
# NSTL_TREES_DIR=./trees
# NSTL_LOGS_DIR=./logs
# NSTL_MODELS_DIR=./models
# NSTL_RERANKERS_DIR=./models/rerankers

# --- GEVR Sandbox Isolation ---
NSTL_SANDBOX_ENABLED=true
NSTL_SANDBOX_TIMEOUT=30.0
NSTL_SANDBOX_MAX_MEMORY_MB=8192
NSTL_SANDBOX_MAX_CPU_SECONDS=30
NSTL_SMOKE_TEST_LOOP_BOUND=2

# --- Inference Profile & Model Discovery ---
# Profiles: 0 (Pure Symbolic), A..E (Ablations), O (Unified Flagship)
NSTL_PROFILE=0
# NSTL_EMBEDDER_MODEL=qwen3-embedding-0.6b
# NSTL_EMBEDDER_TASK=
# NSTL_LLM_MODEL=qwen3.5-0.8b-instruct
# NSTL_RERANKER_MODEL=jina-reranker-v3.5
NSTL_USE_RERANKER=false
NSTL_LLM_CONTEXT_LENGTH=4096
NSTL_LLM_TEMPERATURE=0.1
NSTL_LLM_TOP_P=0.95
NSTL_LLM_REPEAT_PENALTY=1.1
NSTL_LLM_MAX_TOKENS=1024
# NSTL_LLM_SEED=
NSTL_MAX_EMBEDDING_CACHE_SIZE=16384

# --- Retrieval & Type-Directed Planner ---
NSTL_RETRIEVAL_DOMAIN_HINT_BONUS=0.0
NSTL_MAX_BRIDGE_HOPS=3
NSTL_AMBIGUITY_TEMPERATURE=0.10
NSTL_AMBIGUITY_ENTROPY_THRESHOLD=0.85
NSTL_AMBIGUITY_MARGIN_THRESHOLD=0.15
